APP_ENV=development

POSTGRES_DB=dc_inventory
POSTGRES_USER=dc_inventory
POSTGRES_PASSWORD=replace-with-a-strong-owner-secret

# Production runtime roles.
# Use distinct URL-safe secrets, for example: openssl rand -hex 32
POSTGRES_RUNTIME_USER=dc_inventory_app
POSTGRES_RUNTIME_PASSWORD=replace-with-a-distinct-runtime-secret
POSTGRES_TELEGRAM_WORKER_USER=dc_inventory_telegram_worker
POSTGRES_TELEGRAM_WORKER_PASSWORD=replace-with-a-distinct-telegram-worker-secret
POSTGRES_EMAIL_WORKER_USER=dc_inventory_email_worker
POSTGRES_EMAIL_WORKER_PASSWORD=replace-with-a-distinct-email-worker-secret

# One-way credential-split cutover. This is NOT an active runtime identity.
# On the first deploy after the split, set this to the exact former
# POSTGRES_WORKER_USER if production used a non-default legacy role name.
POSTGRES_LEGACY_WORKER_USER=dc_inventory_worker

POSTGRES_MAINTENANCE_USER=dc_inventory_maintenance
POSTGRES_MAINTENANCE_PASSWORD=replace-with-a-separate-strong-secret

POSTGRES_DEV_PORT=55432
WEB_PORT=8080

# Development compose only. Production compose constructs five separate
# owner/runtime/Telegram-worker/email-worker/maintenance DB identities from the POSTGRES_* variables
# above. Owner is used by migration/permission bootstrap only.
DATABASE_URL=postgresql+asyncpg://dc_inventory:replace-with-a-strong-owner-secret@postgres:5432/dc_inventory
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_SECONDS=30
DATABASE_LOCK_TIMEOUT_SECONDS=5
MIGRATION_STATEMENT_TIMEOUT_SECONDS=300
MIGRATION_LOCK_TIMEOUT_SECONDS=5

# Fail-closed production-data gate.
# Keep false until an explicit enablement decision in the next roadmap.
REAL_INVENTORY_MUTATIONS_ENABLED=false

# Telegram Mini App authentication
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
ACCESS_CALLBACK_TTL_SECONDS=900
ADMIN_TELEGRAM_USER_ID=123456789
NOTIFICATION_TELEGRAM_USER_ID=987654321
SUPPORT_TELEGRAM_USERNAME=Humoristttt
AUTH_SESSION_TTL_SECONDS=43200
AUTH_COOKIE_NAME=dc_inventory_session

# Telegram webhook + delivery
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
TELEGRAM_WEB_APP_URL=https://app.spik-inventory.ru
TELEGRAM_GATEWAY_URL=https://replace-with-worker-host
TELEGRAM_GATEWAY_SECRET=replace-with-a-separate-random-gateway-secret
TELEGRAM_GATEWAY_TIMEOUT_SECONDS=10
NOTIFICATION_WORKER_POLL_SECONDS=2
NOTIFICATION_WORKER_CLAIM_TTL_SECONDS=60
NOTIFICATION_WORKER_BATCH_SIZE=10
NOTIFICATION_WORKER_MAX_ATTEMPTS=8

# Optional Microsoft Graph email delivery phase. The email-worker service is
# profile-gated and both API/worker fail closed unless this flag and all four
# Graph values are configured. Enable the flag only together with --profile email.
EMAIL_DELIVERY_ENABLED=false
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER=
MICROSOFT_GRAPH_TIMEOUT_SECONDS=15
EMAIL_WORKER_POLL_SECONDS=5
EMAIL_WORKER_CLAIM_TTL_SECONDS=60
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_MAX_ATTEMPTS=8

# Bounded technical-data retention
MAINTENANCE_WORKER_POLL_SECONDS=3600
MAINTENANCE_RETENTION_BATCH_SIZE=1000
AUTH_SESSION_RETENTION_DAYS=7
TELEGRAM_UPDATE_RETENTION_DAYS=30
NOTIFICATION_OUTBOX_RETENTION_DAYS=90
EMAIL_OUTBOX_RETENTION_DAYS=90
ACCESS_CALLBACK_RETENTION_DAYS=30

POSTGRES_CPUS_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=3g
MIGRATE_CPUS_LIMIT=1.0
MIGRATE_MEMORY_LIMIT=512m
DB_PERMISSIONS_CPUS_LIMIT=0.5
DB_PERMISSIONS_MEMORY_LIMIT=256m
BACKEND_CPUS_LIMIT=1.5
BACKEND_MEMORY_LIMIT=1g
TELEGRAM_WORKER_CPUS_LIMIT=0.5
TELEGRAM_WORKER_MEMORY_LIMIT=512m
EMAIL_WORKER_CPUS_LIMIT=0.5
EMAIL_WORKER_MEMORY_LIMIT=512m
MAINTENANCE_WORKER_CPUS_LIMIT=0.5
MAINTENANCE_WORKER_MEMORY_LIMIT=512m
WEB_CPUS_LIMIT=0.5
WEB_MEMORY_LIMIT=256m
